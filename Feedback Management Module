FeedbackForm.cshtml
@model FeedbackManagement.Models.Feedback

<form asp-controller="Feedback"
      asp-action="Index"
      method="post">

    <!-- Full Name -->
    <div class="mb-3">
        @Html.LabelFor(model => model.Name,
            new { @class = "form-label" })

        @Html.TextBoxFor(model => model.Name, new
        {
            @class = "form-control",
            placeholder = "Enter your full name"
        })

        @Html.ValidationMessageFor(model => model.Name, "",
            new { @class = "text-danger" })
    </div>

    <!-- Email -->
    <div class="mb-3">
        @Html.LabelFor(model => model.Email,
            new { @class = "form-label" })

        @Html.TextBoxFor(model => model.Email, new
        {
            @class = "form-control",
            type = "email",
            placeholder = "example@gmail.com"
        })

        @Html.ValidationMessageFor(model => model.Email, "",
            new { @class = "text-danger" })
    </div>

    <!-- Rating -->
    <div class="mb-3">
        @Html.LabelFor(model => model.Rating,
            new { @class = "form-label" })

        <div class="mt-2">

            <div class="form-check">
                @Html.RadioButtonFor(
                    model => model.Rating,
                    "Excellent",
                    new { @class = "form-check-input" })

                <label class="form-check-label">
                    Excellent
                </label>
            </div>

            <div class="form-check">
                @Html.RadioButtonFor(
                    model => model.Rating,
                    "Good",
                    new { @class = "form-check-input" })

                <label class="form-check-label">
                    Good
                </label>
            </div>

            <div class="form-check">
                @Html.RadioButtonFor(
                    model => model.Rating,
                    "Average",
                    new { @class = "form-check-input" })

                <label class="form-check-label">
                    Average
                </label>
            </div>

            <div class="form-check">
                @Html.RadioButtonFor(
                    model => model.Rating,
                    "Poor",
                    new { @class = "form-check-input" })

                <label class="form-check-label">
                    Poor
                </label>
            </div>

        </div>

        @Html.ValidationMessageFor(model => model.Rating, "",
            new { @class = "text-danger" })
    </div>

    <!-- Feedback -->
    <div class="mb-3">
        @Html.LabelFor(model => model.Message,
            new { @class = "form-label" })

        @Html.TextAreaFor(model => model.Message, new
        {
            @class = "form-control",
            rows = "5",
            placeholder = "Enter your feedback (10-500 characters)"
        })

        @Html.ValidationMessageFor(model => model.Message, "",
            new { @class = "text-danger" })
    </div>

    <!-- Buttons -->
    <div class="mt-4">
        <button type="submit"
                class="btn btn-primary">
            Submit Feedback
        </button>

        <button type="reset"
                class="btn btn-secondary">
            Reset
        </button>
    </div>

</form>

